flowchart TD
    A["main.py main()"] --> B["讀取執行設定\nbattle_count / log_level / 是否執行"]
    B --> C["建立 BattleReporter"]
    B --> D["讀取 CombatInputPanel.xlsx\nRuntimeInputRepository.load_combat_input_panel"]
    D --> D1["輸出 inputs_by_char\nDict(character_id -> CharacterLoadoutInput)"]

    D1 --> E["Phase1 靜態數值計算\ncalc_all_character_snapshots()"]
    E --> E1["讀 Character.xlsx / Partner.xlsx"]
    E1 --> E2["輸出 CharacterSnapshot 清單"]
    E2 --> F["組成 PlayerPartySnapshot"]

    D1 --> G["建立 ability_ctx"]

    B --> H["讀 Card.xlsx (Card, CardEffect)"]
    H --> H1["輸出 party_cards 與 effects_by_card_id"]

    B --> I["讀 Monster.xlsx (Index/BaseStat/Skill)"]
    I --> I1["輸出 monster_indexes / monster_base_stats / monster_skills"]

    B --> J["嘗試建立 AbilitySystem"]
    J --> J1{"目前是否成功?"}
    J1 -- "否" --> J2["ability_system = None"]
    J1 -- "是" --> J3["戰鬥中觸發 Ability 分支"]

    F --> K["建立 BattleSimulator + BattleConfig"]
    H1 --> K
    I1 --> K
    J2 --> K
    G --> K
    C --> K

    K --> L["run_battles()"]
    L --> M["_run_one_battle()"]
    M --> M1["抽怪與初始化戰鬥狀態"]
    M1 --> M2["回合迴圈：玩家階段 -> 敵方階段"]
    M2 --> N{"勝負判定"}
    N -->|玩家勝| O["BattleResult"]
    N -->|敵方勝| O
    N -->|超時| O

    O --> P["main.py 收集 summary rows"]
    P --> Q["BattleReporter.add_summary / add_event"]
    Q --> R["flush_to_excel() 輸出 Reports/*.xlsx"]